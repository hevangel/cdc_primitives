[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 20
prove: mode prove
prove: depth 20
cover: mode cover
cover: depth 40

[engines]
bmc: abc bmc3
prove: abc pdr
cover: smtbmc --syn --nopresat z3

[script]
read -formal -D FORMAL -D CDC_PINGPONG_FTOP cdc_pingpong.sv cdc_bus_mcp.sv cdc_sync_toggle.sv
prep -top cdc_pingpong
memory_map

[files]
../rtl/cdc_pingpong.sv
../rtl/cdc_bus_mcp.sv
../rtl/cdc_sync_toggle.sv

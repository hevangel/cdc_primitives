[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 20
prove: mode prove
prove: depth 20
cover: mode cover
cover: depth 40

[engines]
bmc: abc bmc3
prove: abc pdr
cover: smtbmc --syn --nopresat z3

[script]
read -formal -D FORMAL -D AXIS_CDC_FTOP axis_cdc.sv cdc_async_fifo.sv
prep -top axis_cdc
memory_map

[files]
../rtl/bridges/axis_cdc.sv
../rtl/cdc_async_fifo.sv

[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 20
prove: mode prove
prove: depth 20
cover: mode cover
cover: depth 40

[engines]
bmc: abc bmc3
prove: abc pdr
cover: smtbmc --syn --nopresat z3

[script]
read -formal -D FORMAL -D APB_CDC_FTOP apb_cdc.sv cdc_bus_handshake.sv
prep -top apb_cdc
memory_map

[files]
../rtl/bridges/apb_cdc.sv
../rtl/cdc_bus_handshake.sv

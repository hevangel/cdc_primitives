[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 20
prove: mode prove
prove: depth 20
cover: mode cover
cover: depth 40

[engines]
bmc: abc bmc3
prove: abc pdr
cover: smtbmc --syn --nopresat z3

[script]
read -formal -D FORMAL -D CDC_SNAPSHOT_FTOP cdc_snapshot.sv cdc_bus_mcp.sv
prep -top cdc_snapshot
memory_map

[files]
../rtl/cdc_snapshot.sv
../rtl/cdc_bus_mcp.sv

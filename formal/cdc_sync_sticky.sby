[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 20
prove: mode prove
prove: depth 20
cover: mode cover
cover: depth 40

[engines]
bmc: abc bmc3
prove: abc pdr
cover: smtbmc --syn --nopresat z3

[script]
read -formal -D FORMAL -D CDC_SYNC_STICKY_FTOP cdc_sync_sticky.sv
prep -top cdc_sync_sticky
memory_map

[files]
../rtl/cdc_sync_sticky.sv
